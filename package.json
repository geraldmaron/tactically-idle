{
  "name": "tactically-idle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "check:art": "node scripts/validate-art.mjs",
    "verify": "npm run typecheck && npm test && npm run check:art && npm run build",
    "test:e2e": "node scripts/play-loop.mjs",
    "capture:locations": "node scripts/capture-locations.mjs",
    "check:strings": "bun scripts/check-strings.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
